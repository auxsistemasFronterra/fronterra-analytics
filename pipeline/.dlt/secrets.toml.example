# Copia este archivo a .dlt/secrets.toml y llena los valores reales.
# .dlt/secrets.toml está en .gitignore: NUNCA lo subas al repo.

# --- SAP HANA (on-premise, Business One) ---
[sources.hana.credentials]
drivername = "hana+hdbcli"
host = "HOST_HANA"
port = 30015
username = "USUARIO_HANA"
password = "CONTRASEÑA_HANA"

[sources.hana.credentials.query]
# El servidor HANA no tiene TLS configurado
encrypt = "false"

# --- PostgreSQL en Railway (base hanaDB) ---
# Railway > servicio Postgres > Variables > DATABASE_PUBLIC_URL, cambiando la base final a /hanaDB
[destination.postgres]
credentials = "postgresql://USUARIO:CONTRASEÑA@HOST.proxy.rlwy.net:PUERTO/hanaDB"

# --- Google BigQuery (cuenta de servicio) ---
# Copia los 3 campos del JSON de la llave de la cuenta de servicio (nunca subas el JSON al repo)
[destination.bigquery.credentials]
project_id = "ID_DEL_PROYECTO"
client_email = "CUENTA@ID_DEL_PROYECTO.iam.gserviceaccount.com"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
