# Alternativa a .dlt/secrets.toml usando variables de entorno (dlt las lee automáticamente).
# Copia a .env y llena valores reales. .env está en .gitignore.
SOURCES__HANA__CREDENTIALS__HOST=HOST_HANA
SOURCES__HANA__CREDENTIALS__PORT=30015
SOURCES__HANA__CREDENTIALS__USERNAME=USUARIO_HANA
SOURCES__HANA__CREDENTIALS__PASSWORD=CONTRASEÑA_HANA
DESTINATION__POSTGRES__CREDENTIALS=postgresql://USUARIO:CONTRASEÑA@HOST.proxy.rlwy.net:PUERTO/hanaDB
DESTINATION__BIGQUERY__CREDENTIALS__PROJECT_ID=ID_DEL_PROYECTO
DESTINATION__BIGQUERY__CREDENTIALS__CLIENT_EMAIL=CUENTA@ID_DEL_PROYECTO.iam.gserviceaccount.com
DESTINATION__BIGQUERY__CREDENTIALS__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
