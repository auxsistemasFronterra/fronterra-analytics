# Opcional. Copia este archivo como .env si necesitas cambiar algo.

# Conexión fija a Postgres (si no, se pide en la página y se guarda en config.json)
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/base

# Protege la página con contraseña
# APP_PASSWORD=

# Puerto de la página (por defecto 3000)
# PORT=3000
