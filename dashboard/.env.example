# Copia este archivo como .env y llena los valores. El .env NUNCA va al repo (el repo es público).

# ---- Login con Microsoft (Entra ID → Registros de aplicaciones → Fronterra Dashboards) ----
AZURE_TENANT_ID=        # Id. de directorio (inquilino)
AZURE_CLIENT_ID=        # Id. de aplicación (cliente)
AZURE_CLIENT_SECRET=    # Valor del secreto de cliente (vence: anota la fecha)

# Id. de objeto de cada grupo de seguridad (Entra ID → Grupos)
GROUP_READERS_ID=       # Dashboards-Lectores: ver
GROUP_EDITORS_ID=       # Dashboards-Editores: ver, crear y renombrar dashboards, quitar gráficas
GROUP_ADMINS_ID=        # Dashboards-Admin: todo, incluida la conexión a la base

# Dirección pública (debe estar registrada en Entra ID como .../auth/callback).
# http://localhost:PORT/auth/callback también se acepta para pruebas en el servidor.
BASE_URL=https://fronterra-portal.vdv.one

# Firma de la cookie de sesión: texto aleatorio de 32+ caracteres. Si cambia, todos vuelven a entrar.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Horas que dura la sesión (un cambio de grupos aplica en el siguiente login)
# SESSION_HOURS=8

# Solo para probar en este equipo sin login (rechaza peticiones que no sean de localhost). Nunca en producción.
# AUTH_DISABLED=1

# ---- Servidor ----
# PORT=8501
# HOST=127.0.0.1        # solo local; el túnel de Cloudflare entra por localhost

# ---- Base de datos ----
# Conexión fija a Postgres (si no, un Admin la pega en la página y se guarda en config.json)
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/base
